<resources>
    <!-- Base theme required by manifest before Compose takes over -->
    <style name="Theme.Sleek" parent="android:Theme.Material.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Sleek.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.Sleek</item>
    </style>
</resources>
