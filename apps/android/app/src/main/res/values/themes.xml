<resources>
    <!-- Base theme for Compose + Material 3 -->
    <style name="Theme.Sleek" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Sleek.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.Sleek</item>
    </style>
</resources>
