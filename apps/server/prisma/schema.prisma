// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  username  String?  @unique
  tag       String   @unique
  avatarUrl String?
  fcmToken  String?                        // FCM device token for push notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentMessages   Message[]  @relation("MessageSender")
  pinnedMessages Message[]  @relation("MessagePinner")   // Fix #3: who pinned
  chatMembers    ChatMember[]

  @@index([googleId])
}

model Chat {
  id        String     @id @default(cuid())
  type      ChatType   @default(DM)
  name      String?                      // Fix #5: for GROUP chats
  avatarUrl String?                      // Fix #5: for GROUP chats
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members  ChatMember[]
  messages Message[]
}

model ChatMember {
  id       String   @id @default(cuid())
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id              String    @id @default(cuid())
  chat            Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId          String

  // Fix #2: Restrict prevents user deletion while they have messages
  sender          User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  senderId        String

  content         String
  edited          Boolean   @default(false)
  originalContent String?

  // Fix #4: Soft delete — null means active, set to delete timestamp when "deleted"
  deletedAt       DateTime?

  pinned          Boolean   @default(false)
  pinnedAt        DateTime?

  // Fix #3: Track who pinned the message
  pinnedBy        User?     @relation("MessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  pinnedById      String?

  replyToId       String?
  replyTo         Message?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies         Message[] @relation("MessageReply")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId, pinned])
  @@index([chatId, deletedAt])  // Fix #4: fast soft-delete filter
}

enum ChatType {
  DM
  GROUP
}
